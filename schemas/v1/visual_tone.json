{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meminmutlu-ui.github.io/open-videograph-schema/schemas/v1/visual_tone.json",
  "title": "VideoGraph Visual Tone & Color Palette Schema",
  "description": "Schema for scene brightness, contrast, color palette extraction, and visual mood.",
  "type": "object",
  "required": [
    "scene_id",
    "start",
    "end",
    "brightness",
    "palette"
  ],
  "properties": {
    "scene_id": {
      "type": "string"
    },
    "start": {
      "type": "number"
    },
    "end": {
      "type": "number"
    },
    "duration": {
      "type": "number"
    },
    "brightness": {
      "type": "number"
    },
    "contrast": {
      "type": "number"
    },
    "palette": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "example": [
        "#1A2B3C",
        "#F0E1D2"
      ]
    },
    "mood": {
      "type": "string"
    }
  }
}